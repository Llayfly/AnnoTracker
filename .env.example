# ===== 数据标注平台账号 =====
AM_PLATFORM_BASE_URL=https://data-platform.synapath.com
AM_PLATFORM_EMAIL=198176@qq.com
AM_PLATFORM_PASSWORD=qwe123
AM_PLATFORM_ORG=HC

# ===== 本地开发配置（Vercel 部署不需要以下项）=====
# 服务监听端口
AM_PORT=3000
# SQLite 数据库文件路径（本地用，Vercel 用 Turso）
AM_DB_PATH=./data/stats.db
# 首次启动回填天数
AM_BACKFILL_DAYS=30
# 无片段等效系数
AM_NO_CLIP_FACTOR=0.2
# 单日采集请求间隔(毫秒)
AM_REQUEST_DELAY_MS=800
# 采集超时(毫秒)
AM_REQUEST_TIMEOUT_MS=30000

# ===== 网站登录认证 =====
AM_AUTH_USERNAME=admin
AM_AUTH_PASSWORD=qaz123456
AM_JWT_SECRET=annotator-monitor-secret-2026
AM_TOKEN_EXPIRES_IN=7d

# ===== Vercel 部署专用 =====
# Turso 数据库连接（在 https://turso.tech 注册后获取）
TURSO_DATABASE_URL=libsql://your-db-name-your-org.turso.io
TURSO_AUTH_TOKEN=eyJhbGciOiJFZERTQSIsInR5cCI6IkpXVCJ9...
# 定时采集密钥（自定义随机字符串，Vercel Cron 和外部 cron 调用 /api/cron 时验证）
CRON_SECRET=your-random-secret-string-here
