# ===== 数据标注平台账号 =====
AM_PLATFORM_BASE_URL=https://data-platform.synapath.com
AM_PLATFORM_EMAIL=198176@qq.com
AM_PLATFORM_PASSWORD=qwe123
AM_PLATFORM_ORG=HC

# ===== 本系统配置 =====
# 服务监听端口
AM_PORT=3000
# SQLite 数据库文件路径
AM_DB_PATH=./data/stats.db
# 首次启动回填天数
AM_BACKFILL_DAYS=30
# 无片段等效系数
AM_NO_CLIP_FACTOR=0.2
# 单日采集请求间隔(毫秒)，避免触发平台限流
AM_REQUEST_DELAY_MS=800
# 采集超时(毫秒)
AM_REQUEST_TIMEOUT_MS=30000

# ===== 网站登录认证 =====
# 登录用户名
AM_AUTH_USERNAME=admin
# 登录密码
AM_AUTH_PASSWORD=admin123
# JWT 签名密钥（生产环境务必修改）
AM_JWT_SECRET=annotator-monitor-secret-2026
# Token 有效期
AM_TOKEN_EXPIRES_IN=7d
